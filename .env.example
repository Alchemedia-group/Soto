# Shared database (Supabase) so phone and computer see the same data.
# Leave empty to run in local-only mode (data stays in this browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the app once it is hosted (used in the quote acceptance links). Empty = use the current address.
NEXT_PUBLIC_APP_URL=

# Voice assistant (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: model used by the assistant (fast/cheap by default)
ANTHROPIC_MODEL=claude-haiku-5-5
